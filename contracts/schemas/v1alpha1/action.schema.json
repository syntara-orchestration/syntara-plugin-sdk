{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntara.io/v1alpha1/action.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "syntara.io/v1alpha1"},
    "kind": {"const": "Action"},
    "metadata": {"$ref": "common.schema.json#/$defs/targetMetadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "input", "output"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["platform-runner", "custom-workload"]},
            "entryPoint": {
              "type": "string",
              "description": "Python module:Class implementation identifier, resolved only from the immutable installed workload image and step revision.",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
            },
            "driver": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$"},
            "operation": {"$ref": "http-operation.schema.json#/$defs/operation"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "platform-runner"}}},
              "then": {"required": ["driver"]}
            },
            {
              "if": {"properties": {"kind": {"const": "custom-workload"}}},
              "then": {
                "required": ["entryPoint"],
                "not": {
                  "anyOf": [
                    {"required": ["driver"]},
                    {"required": ["operation"]}
                  ]
                }
              }
            },
            {
              "if": {
                "required": ["driver"],
                "properties": {"driver": {"const": "http.v1"}}
              },
              "then": {"required": ["operation"]}
            },
            {
              "if": {"required": ["operation"]},
              "then": {"properties": {"driver": {"const": "http.v1"}}}
            }
          ]
        },
        "integrationType": {"$ref": "common.schema.json#/$defs/qualifiedIdentifier"},
        "input": {"$ref": "common.schema.json#/$defs/documentSource"},
        "output": {"$ref": "common.schema.json#/$defs/documentSource"},
        "error": {"$ref": "common.schema.json#/$defs/documentSource"}
      }
    }
  }
}
