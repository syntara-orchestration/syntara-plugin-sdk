{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntara.io/v1alpha1/runtime.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/standardOutputWrapper"},
    {"$ref": "#/$defs/workItem"},
    {"$ref": "#/$defs/workloadRequest"},
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/failure"},
    {"$ref": "#/$defs/cancellation"},
    {"$ref": "#/$defs/policySnapshot"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "digestReference": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]*@sha256:[a-f0-9]{64}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "errorResultBase": {
      "description": "Required fields and closed category/code registry for a deliberate failure.",
      "type": "object",
      "required": ["category", "code", "message", "retryable"],
      "properties": {
        "category": {"enum": ["validation", "authentication", "authorization", "business", "dependency", "timeout", "cancelled", "policy", "contract", "internal", "unknown"]},
        "code": {"enum": ["INVALID_INPUT", "VALIDATION_FAILED", "MISCONFIGURATION", "UNSUPPORTED", "AUTHENTICATION_FAILED", "AUTHORIZATION_FAILED", "BUSINESS_RULE_FAILED", "DEPENDENCY_FAILED", "RATE_LIMITED", "RESOURCE_EXHAUSTED", "NOT_FOUND", "TIMEOUT_EXCEEDED", "CANCELLED", "POLICY_DENIED", "CONTRACT_VIOLATION", "INTERNAL_ERROR", "UNKNOWN"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retryable": {"type": "boolean", "description": "Whether another attempt with the same step definition and workflow input may succeed."}
      },
      "oneOf": [
        {"properties": {"category": {"const": "validation"}, "code": {"enum": ["INVALID_INPUT", "VALIDATION_FAILED", "MISCONFIGURATION", "UNSUPPORTED"]}}},
        {"properties": {"category": {"const": "authentication"}, "code": {"enum": ["AUTHENTICATION_FAILED"]}}},
        {"properties": {"category": {"const": "authorization"}, "code": {"enum": ["AUTHORIZATION_FAILED"]}}},
        {"properties": {"category": {"const": "business"}, "code": {"enum": ["BUSINESS_RULE_FAILED"]}}},
        {"properties": {"category": {"const": "dependency"}, "code": {"enum": ["DEPENDENCY_FAILED", "RATE_LIMITED", "RESOURCE_EXHAUSTED", "NOT_FOUND"]}}},
        {"properties": {"category": {"const": "timeout"}, "code": {"enum": ["TIMEOUT_EXCEEDED"]}}},
        {"properties": {"category": {"const": "cancelled"}, "code": {"enum": ["CANCELLED"]}}},
        {"properties": {"category": {"const": "policy"}, "code": {"enum": ["POLICY_DENIED"]}}},
        {"properties": {"category": {"const": "contract"}, "code": {"enum": ["CONTRACT_VIOLATION"]}}},
        {"properties": {"category": {"const": "internal"}, "code": {"enum": ["INTERNAL_ERROR"]}}},
        {"properties": {"category": {"const": "unknown"}, "code": {"enum": ["UNKNOWN"]}}}
      ]
    },
    "errorResult": {
      "description": "SDK fallback ErrorResult when no step type-specific error schema is declared.",
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "message", "retryable"],
      "properties": {
        "category": {"enum": ["validation", "authentication", "authorization", "business", "dependency", "timeout", "cancelled", "policy", "contract", "internal", "unknown"]},
        "code": {"enum": ["INVALID_INPUT", "VALIDATION_FAILED", "MISCONFIGURATION", "UNSUPPORTED", "AUTHENTICATION_FAILED", "AUTHORIZATION_FAILED", "BUSINESS_RULE_FAILED", "DEPENDENCY_FAILED", "RATE_LIMITED", "RESOURCE_EXHAUSTED", "NOT_FOUND", "TIMEOUT_EXCEEDED", "CANCELLED", "POLICY_DENIED", "CONTRACT_VIOLATION", "INTERNAL_ERROR", "UNKNOWN"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retryable": {"type": "boolean", "description": "Whether another attempt with the same step definition and workflow input may succeed."}
      },
      "oneOf": [
        {"properties": {"category": {"const": "validation"}, "code": {"enum": ["INVALID_INPUT", "VALIDATION_FAILED", "MISCONFIGURATION", "UNSUPPORTED"]}}},
        {"properties": {"category": {"const": "authentication"}, "code": {"enum": ["AUTHENTICATION_FAILED"]}}},
        {"properties": {"category": {"const": "authorization"}, "code": {"enum": ["AUTHORIZATION_FAILED"]}}},
        {"properties": {"category": {"const": "business"}, "code": {"enum": ["BUSINESS_RULE_FAILED"]}}},
        {"properties": {"category": {"const": "dependency"}, "code": {"enum": ["DEPENDENCY_FAILED", "RATE_LIMITED", "RESOURCE_EXHAUSTED", "NOT_FOUND"]}}},
        {"properties": {"category": {"const": "timeout"}, "code": {"enum": ["TIMEOUT_EXCEEDED"]}}},
        {"properties": {"category": {"const": "cancelled"}, "code": {"enum": ["CANCELLED"]}}},
        {"properties": {"category": {"const": "policy"}, "code": {"enum": ["POLICY_DENIED"]}}},
        {"properties": {"category": {"const": "contract"}, "code": {"enum": ["CONTRACT_VIOLATION"]}}},
        {"properties": {"category": {"const": "internal"}, "code": {"enum": ["INTERNAL_ERROR"]}}},
        {"properties": {"category": {"const": "unknown"}, "code": {"enum": ["UNKNOWN"]}}}
      ]
    },
    "standardOutputWrapper": {
      "description": "Immutable StandardOutputWrapper containing a business result or structured error result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "statusCode", "statusMessage", "errorResult"],
      "properties": {
        "result": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "statusCode": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "statusMessage": {"type": "string", "minLength": 1, "maxLength": 4096},
        "errorResult": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/errorResultBase"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"statusCode": {"const": 0}}},
          "then": {
            "properties": {"result": {"not": {"type": "null"}}, "errorResult": {"type": "null"}}
          }
        },
        {
          "if": {"properties": {"statusCode": {"minimum": 1}}},
          "then": {
            "properties": {"errorResult": {"$ref": "#/$defs/errorResultBase"}}
          }
        }
      ]
    },
    "base": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"type": "string"}}
    },
    "workItem": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "stepRevisionId", "pluginDigest", "runtimeAbi", "imageDigest", "integrationHandle", "inputs", "credentialHandles", "capabilityGrantId", "executionPolicyId", "timeoutSeconds", "requestHash"], "properties": {
          "apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerStepWorkItem"},
          "invocationId": {"$ref": "#/$defs/id", "description": "Host-assigned identity for one invocation, used to correlate events, credential requests, and cancellation. EP supplies its dispatch-attempt ID, not a workflow execution ID."}, "stepRevisionId": {"$ref": "#/$defs/id", "description": "Handler identifier advertised by this workload's Health response; selects the implementation to execute, not an individual invocation."}, "pluginDigest": {"$ref": "#/$defs/sha256"}, "runtimeAbi": {"const": "syntara.container/v1alpha2"}, "imageDigest": {"$ref": "#/$defs/digestReference"}, "integrationHandle": {"$ref": "#/$defs/id"}, "inputs": {"type": "object"}, "runtimeContext": {"type": "object", "maxProperties": 64, "description": "Optional non-secret caller-defined JSON object, defaulting to {} and exposed to plugin code as ExecutionContext.runtime_context. The SDK requires no project, workflow, execution, or parent identifiers. These values do not authorize access or select the handler; do not include credentials or other secrets."}, "credentialHandles": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "capabilityGrantId": {"$ref": "#/$defs/id"}, "executionPolicyId": {"$ref": "#/$defs/id"}, "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "requestHash": {"$ref": "#/$defs/sha256"}
        }}
      ]
    },
    "workloadRequest": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "workItem", "policySnapshot"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerWorkloadRequest"}, "workItem": {"$ref": "#/$defs/workItem"}, "policySnapshot": {"$ref": "#/$defs/policySnapshot"}}}]
    },
    "progress": {
      "description": "A non-terminal status update with optional partialResult data. Each data object is a fresh partial view that replaces the previous one; omitted fields are not carried forward. The container runtime checks supplied properties and values against the step output schema while allowing object properties to be omitted; include branch discriminators when reporting fields under conditional schemas. The terminal output uses the unmodified schema. partialResult.isLast marks the last update. The canonical UTF-8 encoding of data must be at most 16384 bytes, with at most 32 top-level members. Partial results are not terminal results.",
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "sequence", "state"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerProgress"}, "invocationId": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1}, "state": {"enum": ["started", "heartbeat", "progress"]}, "message": {"type": "string", "maxLength": 4096}, "percent": {"type": "number", "minimum": 0, "maximum": 100}, "partialResult": {"type": "object", "additionalProperties": false, "required": ["isLast", "data"], "properties": {"isLast": {"type": "boolean"}, "data": {"type": "object", "maxProperties": 32}}}}},
        {"if": {"properties": {"state": {"const": "progress"}}}, "else": {"not": {"required": ["partialResult"]}}}
      ]
    },
    "result": {
      "description": "A terminal result carries an optional business object or object-store reference and, on failure, a structured error and its schema digest.",
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "outputSchemaDigest"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerResult"}, "invocationId": {"$ref": "#/$defs/id"}, "outputSchemaDigest": {"$ref": "#/$defs/sha256"}, "output": {"description": "Inline business result JSON object.", "type": "object"}, "objectReference": {"description": "Opaque reference to an externalized business result; mutually exclusive with output.", "$ref": "#/$defs/id"}, "statusCode": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "statusMessage": {"type": "string", "maxLength": 4096}, "errorResult": {"$ref": "#/$defs/errorResultBase"}, "errorSchemaDigest": {"$ref": "#/$defs/sha256"}}, "not": {"required": ["output", "objectReference"]}},
        {"if": {"properties": {"statusCode": {"const": 0}}}, "then": {"anyOf": [{"required": ["output"]}, {"required": ["objectReference"]}], "not": {"anyOf": [{"required": ["errorResult"]}, {"required": ["errorSchemaDigest"]}]}}},
        {"if": {"required": ["statusCode"], "properties": {"statusCode": {"not": {"const": 0}}}}, "then": {"required": ["errorResult", "errorSchemaDigest"]}}
      ]
    },
    "failure": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "code", "message", "retryable", "outcome"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerFailure"}, "invocationId": {"$ref": "#/$defs/id"}, "code": {"enum": ["INVALID_INPUT", "AUTHENTICATION_FAILED", "AUTHORIZATION_FAILED", "REMOTE_REJECTED", "NOT_FOUND", "CONFLICT", "RATE_LIMITED", "UPSTREAM_TRANSIENT", "TIMEOUT", "CANCELLED", "POLICY_DENIED", "ABI_VIOLATION", "OUTCOME_UNKNOWN", "CREDENTIAL_SCAN_LIMIT"]}, "message": {"type": "string", "minLength": 1, "maxLength": 4096}, "retryable": {"type": "boolean"}, "outcome": {"enum": ["not_started", "not_completed", "unknown"]}, "correlationId": {"$ref": "#/$defs/id"}, "providerCode": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}}}]
    },
    "cancellation": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "fenceToken", "requestedAt"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerCancellation"}, "invocationId": {"$ref": "#/$defs/id"}, "fenceToken": {"$ref": "#/$defs/id"}, "requestedAt": {"type": "string", "format": "date-time"}}}]
    },
    "policySnapshot": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "policyId", "revision", "requestHash", "effectiveCapabilities"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ExecutionPolicySnapshot"}, "policyId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}, "requestHash": {"$ref": "#/$defs/sha256"}, "effectiveCapabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}]
    }
  }
}
