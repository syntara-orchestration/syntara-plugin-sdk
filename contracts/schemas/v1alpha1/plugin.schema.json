{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.syntara.io/v1alpha1/plugin.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["apiVersion", "kind", "metadata", "spec"],
    "properties": {
        "apiVersion": {"const": "syntara.io/v1alpha1"},
        "kind": {"const": "Plugin"},
        "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
        "spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["documentation", "targets"],
            "properties": {
                "workload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["image"],
                    "properties": {"image": {"$ref": "common.schema.json#/$defs/identifier"}}
                },
                "providers": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "image"],
                        "properties": {
                            "id": {"$ref": "common.schema.json#/$defs/identifier"},
                            "image": {"$ref": "common.schema.json#/$defs/identifier"}
                        }
                    }
                },
                "documentation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path"],
                    "properties": {
                        "path": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.md$"
                        }
                    }
                },
                "targets": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.ya?ml$"
                    }
                }
            }
        }
    }
}
