{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntara.io/v1alpha1/runtime-binding-resolved.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "syntara.io/v1alpha1"},
    "kind": {"const": "RuntimeBinding"},
    "metadata": {"$ref": "common.schema.json#/$defs/runtimeBindingMetadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "contract", "workloads"],
      "properties": {
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"$ref": "common.schema.json#/$defs/repository"},
            "digest": {"$ref": "common.schema.json#/$defs/sha256Digest"}
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pluginRevisionId", "contractBundleDigest", "stepRevisionIds"],
          "properties": {
            "pluginRevisionId": {"$ref": "common.schema.json#/$defs/sha256Digest"},
            "contractBundleDigest": {"$ref": "common.schema.json#/$defs/sha256Digest"},
            "stepRevisionIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sha256Digest"}}
          }
        },
        "workloads": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "common.schema.json#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/workloadResolved"}
        }
      }
    }
  },
  "$defs": {
    "optionResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "image", "runtime"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/identifier"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "maxLength": 2000},
        "image": {"$ref": "common.schema.json#/$defs/digestImageReference"},
        "runtime": {"$ref": "#/$defs/runtimeObservation"}
      }
    },
    "runtimeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "description": "Runtime metadata observed from the digest-pinned workload image during SDK build.",
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/runtimeComponentObservation"}
        }
      }
    },
    "runtimeComponentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "executable", "verification"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/identifier"},
        "executable": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^/"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Version reported by a supported runtime probe; omitted when unverified."},
        "verification": {"enum": ["verified", "unverified"], "description": "Whether this SDK version successfully identified the declared runtime executable and version."}
      },
      "allOf": [
        {
          "if": {"properties": {"verification": {"const": "verified"}}, "required": ["verification"]},
          "then": {"required": ["version"]}
        }
      ]
    },
    "workloadResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "options"],
      "properties": {
        "default": {"$ref": "common.schema.json#/$defs/identifier"},
        "options": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/optionResolved"}}
      }
    }
  }
}
