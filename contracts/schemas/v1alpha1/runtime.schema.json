{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntara.io/v1alpha1/runtime.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/standardOutputWrapper"},
    {"$ref": "#/$defs/workItem"},
    {"$ref": "#/$defs/workloadRequest"},
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/failure"},
    {"$ref": "#/$defs/cancellation"},
    {"$ref": "#/$defs/credentialLease"},
    {"$ref": "#/$defs/policySnapshot"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "digestReference": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]*@sha256:[a-f0-9]{64}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "safeErrorMetadata": {
      "description": "Safe structured error metadata for a deliberate failure outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "message", "retryable"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["validation", "authentication", "authorization", "business", "dependency", "timeout", "cancelled", "policy", "contract", "internal"]
        },
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retryable": {"type": "boolean"}
      }
    },
    "standardOutputWrapper": {
      "description": "Immutable StandardOutputWrapper; logical Result, StatusCode, StatusMessage, and ErrorMessage serialize as result, statusCode, statusMessage, and errorMessage.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "statusCode", "statusMessage", "errorMessage"],
      "properties": {
        "result": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "statusCode": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "statusMessage": {"type": "string", "minLength": 1, "maxLength": 4096},
        "errorMessage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safeErrorMetadata"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"statusCode": {"const": 0}}},
          "then": {
            "properties": {"result": {"not": {"type": "null"}}, "errorMessage": {"type": "null"}}
          }
        },
        {
          "if": {"properties": {"statusCode": {"minimum": 1}}},
          "then": {
            "properties": {"errorMessage": {"$ref": "#/$defs/safeErrorMetadata"}}
          }
        }
      ]
    },
    "base": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"type": "string"}}
    },
    "workItem": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "workflowRunId", "stepRevisionId", "pluginDigest", "runtimeAbi", "imageDigest", "integrationHandle", "inputs", "credentialHandles", "capabilityGrantId", "executionPolicyId", "timeoutSeconds", "requestHash"], "properties": {
          "apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerStepWorkItem"},
          "invocationId": {"$ref": "#/$defs/id"}, "workflowRunId": {"$ref": "#/$defs/id"}, "stepRevisionId": {"$ref": "#/$defs/id"}, "pluginDigest": {"$ref": "#/$defs/sha256"}, "runtimeAbi": {"const": "syntara.container/v1alpha1"}, "imageDigest": {"$ref": "#/$defs/digestReference"}, "integrationHandle": {"$ref": "#/$defs/id"}, "inputs": {"type": "object"}, "runtimeContext": {"type": "object", "maxProperties": 64}, "credentialHandles": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "capabilityGrantId": {"$ref": "#/$defs/id"}, "executionPolicyId": {"$ref": "#/$defs/id"}, "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "requestHash": {"$ref": "#/$defs/sha256"}
        }}
      ]
    },
    "workloadRequest": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "workItem", "policySnapshot", "credentialLeases"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerWorkloadRequest"}, "workItem": {"$ref": "#/$defs/workItem"}, "policySnapshot": {"$ref": "#/$defs/policySnapshot"}, "credentialLeases": {"type": "array", "items": {"$ref": "#/$defs/credentialLease"}}}}]
    },
    "progress": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "sequence", "state"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerProgress"}, "invocationId": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1}, "state": {"enum": ["started", "heartbeat", "progress"]}, "message": {"type": "string", "maxLength": 4096}, "percent": {"type": "number", "minimum": 0, "maximum": 100}}}]
    },
    "result": {
      "description": "A terminal result carries an optional inline business object or object-store reference; both are mutually exclusive. Nonzero status requires complete error metadata including a known error category.",
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "outputSchemaDigest"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerResult"}, "invocationId": {"$ref": "#/$defs/id"}, "outputSchemaDigest": {"$ref": "#/$defs/sha256"}, "output": {"description": "Inline business result JSON object.", "type": "object"}, "objectReference": {"description": "Opaque reference to an externalized business result; mutually exclusive with output.", "$ref": "#/$defs/id"}, "statusCode": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "statusMessage": {"type": "string", "maxLength": 4096}, "errorCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}, "errorMessage": {"type": "string", "maxLength": 4096}, "retryable": {"type": "boolean"}, "errorCategory": {"type": "string", "enum": ["validation", "authentication", "authorization", "business", "dependency", "timeout", "cancelled", "policy", "contract", "internal"]}}, "not": {"required": ["output", "objectReference"]}},
        {"if": {"properties": {"statusCode": {"const": 0}}}, "then": {"anyOf": [{"required": ["output"]}, {"required": ["objectReference"]}], "properties": {"errorCode": {"maxLength": 0}, "errorMessage": {"maxLength": 0}, "retryable": {"const": false}, "errorCategory": {"maxLength": 0}}}},
        {"if": {"required": ["statusCode"], "properties": {"statusCode": {"not": {"const": 0}}}}, "then": {"required": ["errorCode", "errorMessage", "retryable", "errorCategory"], "properties": {"errorMessage": {"minLength": 1}}}}
      ]
    },
    "failure": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "code", "message", "retryable", "outcome"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerFailure"}, "invocationId": {"$ref": "#/$defs/id"}, "code": {"enum": ["INVALID_INPUT", "AUTHENTICATION_FAILED", "AUTHORIZATION_FAILED", "REMOTE_REJECTED", "NOT_FOUND", "CONFLICT", "RATE_LIMITED", "UPSTREAM_TRANSIENT", "TIMEOUT", "CANCELLED", "POLICY_DENIED", "ABI_VIOLATION", "OUTCOME_UNKNOWN"]}, "message": {"type": "string", "minLength": 1, "maxLength": 4096}, "retryable": {"type": "boolean"}, "outcome": {"enum": ["not_started", "not_completed", "unknown"]}, "correlationId": {"$ref": "#/$defs/id"}, "providerCode": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}}}]
    },
    "cancellation": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "fenceToken", "requestedAt"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ContainerCancellation"}, "invocationId": {"$ref": "#/$defs/id"}, "fenceToken": {"$ref": "#/$defs/id"}, "requestedAt": {"type": "string", "format": "date-time"}}}]
    },
    "credentialLease": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "leaseId", "credentialHandle", "audience", "expiresAt", "secretFiles"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "CredentialLease"}, "leaseId": {"$ref": "#/$defs/id"}, "credentialHandle": {"$ref": "#/$defs/id"}, "audience": {"$ref": "#/$defs/id"}, "expiresAt": {"type": "string", "format": "date-time"}, "secretFiles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "path"], "properties": {"name": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^/var/run/syntara/secrets/[A-Za-z0-9._-]+$"}}}}}}]
    },
    "policySnapshot": {
      "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "policyId", "revision", "requestHash", "effectiveCapabilities"], "properties": {"apiVersion": {"const": "syntara.io/v1alpha1"}, "kind": {"const": "ExecutionPolicySnapshot"}, "policyId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}, "requestHash": {"$ref": "#/$defs/sha256"}, "effectiveCapabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}]
    }
  }
}
