{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntara.io/v1alpha1/registration-manifest.schema.json",
  "title": "Syntara Custom Runner Registration Manifest",
  "description": "The image-embedded mapping from immutable custom-runner step type revisions to their implementation entry points.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "plugin_revision_id", "sdkVersion", "workload", "steps"],
  "properties": {
    "apiVersion": {"const": "syntara.registration/v1alpha1"},
    "kind": {"const": "RegistrationManifest"},
    "plugin_revision_id": {"$ref": "common.schema.json#/$defs/sha256Digest"},
    "sdkVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "workload": {"$ref": "common.schema.json#/$defs/identifier"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "description": "Runtime component declarations injected by the SDK for image-local version probing and Health reporting.",
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/runtimeComponent"}
        }
      }
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "common.schema.json#/$defs/sha256Digest"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepIdentity", "entryPoint", "abi", "schemaDigests"],
        "properties": {
          "stepIdentity": {"$ref": "common.schema.json#/$defs/qualifiedIdentifier"},
          "entryPoint": {"$ref": "step.schema.json#/$defs/entryPoint"},
          "abi": {"const": "syntara.container/v1alpha1"},
          "schemaDigests": {"$ref": "common.schema.json#/$defs/stepSchemaDigests"}
        }
      }
    }
  },
  "$defs": {
    "runtimeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "executable"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/identifier"},
        "executable": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^/", "description": "Absolute path to the runtime executable inside the workload image."}
      }
    }
  }
}
