{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntara.io/v1alpha1/action.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "syntara.io/v1alpha1"},
    "kind": {"const": "Action"},
    "metadata": {"$ref": "step.schema.json#/$defs/stepMetadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "input", "output"],
      "properties": {
        "domain": {"$ref": "common.schema.json#/$defs/qualifiedIdentifier"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["platform-runner", "custom-runner"]},
            "entryPoint": {"$ref": "step.schema.json#/$defs/entryPoint"},
            "implementation": {"$ref": "step.schema.json#/$defs/implementation"},
            "operation": {"$ref": "http-operation.schema.json#/$defs/operation"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "platform-runner"}}},
              "then": {"required": ["implementation"], "not": {"required": ["entryPoint"]}}
            },
            {
              "if": {"required": ["operation"]},
              "then": {"properties": {"implementation": {"pattern": "^syntara\\.http\\.request@"}}}
            },
            {
              "if": {"properties": {"kind": {"const": "custom-runner"}}},
              "then": {
                "required": ["entryPoint"],
                "not": {
                  "anyOf": [
                    {"required": ["implementation"]},
                    {"required": ["operation"]}
                  ]
                }
              }
            }
          ]
        },
        "integrationType": {"$ref": "common.schema.json#/$defs/qualifiedIdentifier"},
        "input": {"$ref": "common.schema.json#/$defs/documentSource"},
        "output": {"$ref": "common.schema.json#/$defs/documentSource", "description": "Schema for StandardOutputWrapper.result on success; describes the business result, not the wrapper."},
        "error": {"$ref": "common.schema.json#/$defs/documentSource", "description": "Optional declared business-error schema; runtime wrapper metadata remains SDK-defined."}
      }
    }
  }
}
